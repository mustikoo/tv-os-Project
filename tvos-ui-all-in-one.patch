diff --git a/launcher/app/src/test/java/com/gathin/tvhome/HomeLayoutTest.java b/launcher/app/src/test/java/com/gathin/tvhome/HomeLayoutTest.java
new file mode 100644
index 0000000..121ca49
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/HomeLayoutTest.java
@@ -0,0 +1,162 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+/** Plain JVM tests for the home layout file: parsing, the folder rules and the round trip. */
+public class HomeLayoutTest {
+
+    private static HomeLayout fresh() {
+        return new HomeLayout(null);   // no file: nothing is written
+    }
+
+    @Test
+    public void emptyLayoutIsDefault() {
+        HomeLayout l = fresh();
+        assertTrue(l.isDefault());
+        assertNull(l.order());
+        assertEquals("tvhome-layout 1\n", l.encode());
+    }
+
+    @Test
+    public void roundTrip() {
+        HomeLayout l = fresh();
+        l.setOrder(Arrays.asList("com.a/.Main", "com.b/.Main", "com.gathin.tvhome/folder.x"));
+        l.hide("com.junk.app");
+        HomeLayout.Folder f = l.newFolder("Streaming  ", "com.c.player");
+        assertNotNull(f);
+        assertTrue(l.addToFolder(f, "com.d.player"));
+        HomeLayout back = HomeLayout.parse(l.encode(), null);
+        assertNotNull(back);
+        assertEquals(l.order(), back.order());
+        assertTrue(back.hidden().contains("com.junk.app"));
+        assertEquals(1, back.folders().size());
+        assertEquals("Streaming", back.folders().get(0).name);
+        assertEquals(Arrays.asList("com.c.player", "com.d.player"), back.folders().get(0).apps);
+        assertEquals(l.encode(), back.encode());
+    }
+
+    @Test
+    public void wrongHeaderAndOversizeAreRejected() {
+        assertNull(HomeLayout.parse("", null));
+        assertNull(HomeLayout.parse("order com.a/.Main\n", null));
+        assertNull(HomeLayout.parse("tvhome-layout 2\n", null));
+        assertNull(HomeLayout.parse(null, null));
+        char[] big = new char[HomeLayout.MAX_CHARS + 1];
+        Arrays.fill(big, ' ');
+        assertNull(HomeLayout.parse(new String(big), null));
+    }
+
+    @Test
+    public void badLinesAreSkippedNotFatal() {
+        String text = "tvhome-layout 1\n"
+                + "order com.a/.Main\n"
+                + "order bad key\n"                       // a space is not allowed in a key
+                + "order com.b/.Main\n"
+                + "hidden example\n"                      // not a package name
+                + "hidden com.ok.app\n"
+                + "mystery line\n"
+                + "folder F1 Upper\n"                     // ids are lower case
+                + "folder f1 Games\n"
+                + "member f1 com.g.one\n"
+                + "member f1 com.g.one\n"                 // twice
+                + "member nope com.g.two\n"               // no such folder
+                + "member f1 not-a-package\n";
+        HomeLayout l = HomeLayout.parse(text, null);
+        assertNotNull(l);
+        assertEquals(Arrays.asList("com.a/.Main", "com.b/.Main"), l.order());
+        assertEquals(1, l.hidden().size());
+        assertEquals(1, l.folders().size());
+        assertEquals(Arrays.asList("com.g.one"), l.folders().get(0).apps);
+    }
+
+    @Test
+    public void anAppLivesInOneFolderOnly() {
+        HomeLayout l = fresh();
+        HomeLayout.Folder a = l.newFolder("A", "com.x.app");
+        HomeLayout.Folder b = l.newFolder("B", "com.y.app");
+        assertTrue(l.addToFolder(b, "com.x.app"));       // moves it from A to B; A is empty and goes away
+        assertNull(l.folder(a.id));
+        assertEquals(b, l.folderOf("com.x.app"));
+        assertEquals(2, b.apps.size());
+    }
+
+    @Test
+    public void takeOutAndDissolve() {
+        HomeLayout l = fresh();
+        HomeLayout.Folder f = l.newFolder("Games", "com.g.one");
+        l.addToFolder(f, "com.g.two");
+        l.takeOut("com.g.one");
+        assertNull(l.folderOf("com.g.one"));
+        assertEquals(1, f.apps.size());
+        l.takeOut("com.g.two");                           // last one out: the folder goes
+        assertTrue(l.folders().isEmpty());
+        HomeLayout.Folder g = l.newFolder("Again", "com.g.three");
+        l.dissolve(g);
+        assertTrue(l.folders().isEmpty());
+        assertTrue(l.isDefault());
+    }
+
+    @Test
+    public void hidingTakesAnAppOutOfItsFolder() {
+        HomeLayout l = fresh();
+        l.newFolder("Games", "com.g.one");
+        l.hide("com.g.one");
+        assertTrue(l.folders().isEmpty());
+        assertTrue(l.hidden().contains("com.g.one"));
+        l.unhideAll();
+        assertTrue(l.hidden().isEmpty());
+    }
+
+    @Test
+    public void limitsHold() {
+        HomeLayout l = fresh();
+        HomeLayout.Folder f = l.newFolder("Many", "com.m.app0");
+        for (int i = 1; i < HomeLayout.MAX_MEMBERS + 5; i++) l.addToFolder(f, "com.m.app" + i);
+        assertEquals(HomeLayout.MAX_MEMBERS, f.apps.size());
+        List<String> keys = new ArrayList<>();
+        for (int i = 0; i < HomeLayout.MAX_ORDER + 20; i++) keys.add("com.k.app" + i + "/.Main");
+        l.setOrder(keys);
+        assertEquals(HomeLayout.MAX_ORDER, l.order().size());
+    }
+
+    @Test
+    public void folderNamesAreCleanedAndBounded() {
+        assertEquals("Folder", HomeLayout.cleanName(null));
+        assertEquals("Folder", HomeLayout.cleanName("\u202E\n"));
+        assertEquals("A B", HomeLayout.cleanName("A\n\nB"));
+        assertEquals(HomeLayout.NAME_MAX, HomeLayout.cleanName("0123456789012345678901234567890123456789").length());
+        assertTrue(HomeLayout.isName("Streaming"));
+        assertFalse(HomeLayout.isName(" Streaming"));
+    }
+
+    @Test
+    public void resetIsDefaultAgain() {
+        HomeLayout l = fresh();
+        l.setOrder(Arrays.asList("com.a/.Main"));
+        l.hide("com.b.app");
+        assertFalse(l.isDefault());
+        l.reset();
+        assertTrue(l.isDefault());
+    }
+
+    @Test
+    public void keyAndIdCharacters() {
+        assertTrue(HomeLayout.isKey("com.a/.Main"));
+        assertTrue(HomeLayout.isKey("com.a/com.a.Main$Inner"));
+        assertFalse(HomeLayout.isKey("com.a/ Main"));
+        assertFalse(HomeLayout.isKey(""));
+        assertTrue(HomeLayout.isId("f1k2"));
+        assertFalse(HomeLayout.isId("F1"));
+        assertFalse(HomeLayout.isId("1234567890123"));
+    }
+}

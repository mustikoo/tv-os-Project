--- /dev/null
+++ b/tools/banners.ps1
@@ -0,0 +1,41 @@
+# Windows version of banners.sh: push high resolution banners (one image per app, named after its package,
+# e.g. com.netflix.ninja.png; png, jpg or webp, 16:9, under 6 MB) to the launcher and restart Home.
+#
+# Usage: tools\banners.ps1 -TvHost 192.168.1.50 my-banners
+#        tools\banners.ps1 -TvHost 192.168.1.50 -Reset
+param(
+    [Parameter(Position = 0)][string]$Folder,
+    [switch]$Reset,
+    [string]$TvHost = $env:TV_HOST
+)
+$ErrorActionPreference = 'Stop'
+$OutputEncoding = New-Object System.Text.UTF8Encoding $false
+if (-not $TvHost) { throw 'pass -TvHost <tv ip> or set $env:TV_HOST' }
+$env:TV_HOST = $TvHost
+if ($Folder) { $Folder = (Resolve-Path $Folder).Path }
+Set-Location $PSScriptRoot
+$py = 'venv\Scripts\python.exe'
+if (-not (Test-Path $py)) { throw 'run: python -m venv tools\venv; tools\venv\Scripts\python.exe -m pip install -r tools\requirements.txt' }
+$pkg = 'com.gathin.tvhome'
+$dir = "/sdcard/Android/data/$pkg/files/banners"
+
+if ($Reset) {
+    & $py -I tv.py "rm -rf $dir; am force-stop $pkg; am start -n $pkg/.MainActivity >/dev/null; echo reset"
+    exit 0
+}
+if (-not $Folder -or -not (Test-Path $Folder -PathType Container)) { throw 'usage: banners.ps1 <folder of <package>.png|jpg|webp> | -Reset' }
+
+& $py -I tv.py "mkdir -p $dir" | Out-Null
+$n = 0
+foreach ($f in Get-ChildItem -File $Folder) {
+    $ext = $f.Extension.ToLower()
+    if ($ext -notin '.png', '.jpg', '.jpeg', '.webp') { Write-Host "skip $($f.Name) (png, jpg or webp only)"; continue }
+    $name = [IO.Path]::GetFileNameWithoutExtension($f.Name)
+    if ($name -notmatch '\.') { Write-Host "skip $($f.Name): name the file after the package, e.g. com.netflix.ninja.png"; continue }
+    if ($f.Length -gt 6291456) { Write-Host "skip $($f.Name): over 6 MB"; continue }
+    & $py -I b64push.py $f.FullName "$dir/$($f.Name)" | Select-Object -Last 1
+    if ($LASTEXITCODE -ne 0) { throw "upload of $($f.Name) failed" }
+    $n++
+}
+& $py -I tv.py "am force-stop $pkg; am start -n $pkg/.MainActivity >/dev/null; echo applied"
+Write-Host "$n banner(s) on the TV. Undo with: tools\banners.ps1 -TvHost $TvHost -Reset"
diff --git a/tools/banners.sh b/tools/banners.sh
new file mode 100755
index 0000000..44a3e7c
--- /dev/null
+++ b/tools/banners.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# Push high resolution banners to the launcher on the TV. Put one image per app in a folder, named
+# after the app's package: com.netflix.ninja.png, com.google.android.youtube.tv.jpg ... (png, jpg or
+# webp, 16:9, 1280x720 is plenty, under 6 MB). They replace the app's own banner on its tile, and the
+# focused dock app's banner also fills the top shelf behind the dock.
+#
+# Usage: TV_HOST=192.168.1.50 tools/banners.sh my-banners
+#        TV_HOST=192.168.1.50 tools/banners.sh --reset      # remove them all, back to the apps' own banners
+set -euo pipefail
+ARG="${1:-}"
+case "$ARG" in --reset|"") ;; /*) ;; *) ARG="$PWD/$ARG" ;; esac
+cd "$(dirname "$0")"
+: "${TV_HOST:?set TV_HOST to the TV IP address, e.g. TV_HOST=192.168.1.50 $0 my-banners}"
+PY=venv/bin/python
+[ -x "$PY" ] || PY=venv/Scripts/python.exe
+[ -x "$PY" ] || { echo "run: python3 -m venv tools/venv && tools/venv/bin/pip install -r tools/requirements.txt" >&2; exit 1; }
+export MSYS_NO_PATHCONV=1
+PKG=com.gathin.tvhome
+DIR=/sdcard/Android/data/$PKG/files/banners
+tv() { "$PY" -I tv.py "$@"; }
+
+if [ "$ARG" = --reset ]; then
+  tv "rm -rf $DIR; am force-stop $PKG; am start -n $PKG/.MainActivity >/dev/null; echo reset" | tail -n 1
+  exit 0
+fi
+[ -n "$ARG" ] && [ -d "$ARG" ] || { echo "usage: banners.sh <folder of <package>.png|jpg|webp> | --reset" >&2; exit 1; }
+
+tv "mkdir -p $DIR" >/dev/null
+n=0
+for f in "$ARG"/*; do
+  [ -f "$f" ] || continue
+  name=$(basename "$f")
+  case "$name" in
+    *.png|*.jpg|*.jpeg|*.webp) ;;
+    *) echo "skip $name (png, jpg or webp only)"; continue ;;
+  esac
+  pkg="${name%.*}"
+  case "$pkg" in
+    *.*) ;;
+    *) echo "skip $name: name the file after the package, e.g. com.netflix.ninja.png"; continue ;;
+  esac
+  size=$(wc -c < "$f" | tr -d ' ')
+  [ "$size" -le 6291456 ] || { echo "skip $name: over 6 MB"; continue; }
+  "$PY" -I b64push.py "$f" "$DIR/$name" | tail -n 1
+  n=$((n + 1))
+done
+tv "am force-stop $PKG; am start -n $PKG/.MainActivity >/dev/null; echo applied" | tail -n 1
+echo "$n banner(s) on the TV. Undo with: tools/banners.sh --reset"

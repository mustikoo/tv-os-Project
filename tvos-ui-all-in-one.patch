+        paint.setColor(0xFF2A2A2E);
+        c.drawRect(0, 0, w, h, paint);
+        int size = Math.round(h * 0.34f);
+        int gap = Math.round(h * 0.08f);
+        int left = (w - (2 * size + gap)) / 2;
+        int top = (h - (2 * size + gap)) / 2;
+        for (int i = 0; i < Math.min(4, members.size()); i++) {

+        for (int i = 0; i < order.size(); i++) rank.put(order.get(i), i);
+        Collections.sort(list, (a, b) -> {
+            Integer ra = rank.get(keyOf(a)), rb = rank.get(keyOf(b));
+            if (ra == null && rb == null) return 0;
+            if (ra == null) return 1;
+            if (rb == null) return -1;
+            return Integer.compare(ra, rb);
+        });

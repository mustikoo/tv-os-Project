+            Drawable d = icon.getConstantState() != null ? icon.getConstantState().newDrawable().mutate() : icon;
+            Rect saved = new Rect(d.getBounds());
+            int x = left + (i % 2) * (size + gap), y = top + (i / 2) * (size + gap);
+            d.setBounds(x, y, x + size, y + size);

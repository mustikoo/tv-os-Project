diff --git a/launcher/app/src/main/java/com/gathin/tvhome/HomeLayout.java b/launcher/app/src/main/java/com/gathin/tvhome/HomeLayout.java
new file mode 100644
index 0000000..c56a759
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/HomeLayout.java
@@ -0,0 +1,328 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.util.AtomicFile;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * What the owner changed on the TV itself: the order of the tiles, the apps hidden from Home and the
+ * folders. Kept in {@code layout.txt} in the launcher's private storage, one line per fact:
+ *
+ * <pre>
+ * tvhome-layout 1
+ * order com.netflix.ninja/.MainActivity
+ * hidden com.example.junk
+ * folder f1k2 Streaming
+ * member f1k2 com.example.player
+ * </pre>
+ *
+ * No JSON and no regular expressions, like {@link Cards}: plain character checks, so the parser can be
+ * unit tested on the JVM and a damaged file means "no changes", never a crash on the home screen.
+ * An absent order means the default one (dock apps from config, cards, then alphabetical).
+ */
+final class HomeLayout {
+
+    static final String FILE = "layout.txt";
+    private static final String HEADER = "tvhome-layout 1";
+    private static final String TAG = "TvHome.Layout";
+    static final int MAX_CHARS = 64 * 1024;
+    static final int MAX_ORDER = 400;
+    static final int MAX_HIDDEN = 200;
+    static final int MAX_FOLDERS = 16;
+    static final int MAX_MEMBERS = 24;
+    static final int NAME_MAX = 24;
+
+    /** A named group of apps shown as one tile. */
+    static final class Folder {
+        final String id;
+        String name;
+        final List<String> apps = new ArrayList<>();
+
+        Folder(String id, String name) {
+            this.id = id;
+            this.name = name;
+        }
+    }
+
+    /** Null in tests: nothing is written. */
+    private final File file;
+    private List<String> order;
+    private final Set<String> hidden = new LinkedHashSet<>();
+    private final List<Folder> folders = new ArrayList<>();
+
+    HomeLayout(File file) {
+        this.file = file;
+    }
+
+    // ---- reading ---------------------------------------------------------------------------------
+
+    /** The saved layout, or an empty one when there is none or it does not read. */
+    static HomeLayout load(Context ctx) {
+        File f = new File(ctx.getFilesDir(), FILE);
+        if (!f.isFile()) return new HomeLayout(f);
+        try {
+            String text = new String(new AtomicFile(f).readFully(), StandardCharsets.UTF_8);
+            HomeLayout parsed = parse(text, f);
+            if (parsed != null) return parsed;
+            Log.w(TAG, FILE + " does not read; starting from the default layout");
+        } catch (IOException e) {
+            Log.w(TAG, "cannot read " + FILE + ": " + e);
+        }
+        return new HomeLayout(f);
+    }
+
+    /** The layout in this text, or null when the header is wrong or the text is too big. Bad lines are skipped. */
+    static HomeLayout parse(String text, File file) {
+        if (text == null || text.length() > MAX_CHARS) return null;
+        HomeLayout out = new HomeLayout(file);
+        boolean header = false;
+        int start = 0;
+        for (int i = 0; i <= text.length(); i++) {
+            if (i < text.length() && text.charAt(i) != '\n') continue;
+            String line = text.substring(start, i);
+            start = i + 1;
+            if (line.endsWith("\r")) line = line.substring(0, line.length() - 1);
+            if (line.isEmpty()) continue;
+            if (!header) {
+                if (!line.equals(HEADER)) return null;
+                header = true;
+                continue;
+            }
+            int sp = line.indexOf(' ');
+            if (sp <= 0 || sp == line.length() - 1) continue;
+            String kind = line.substring(0, sp);
+            String rest = line.substring(sp + 1);
+            switch (kind) {
+                case "order":
+                    if (isKey(rest) && out.orderSize() < MAX_ORDER) out.addOrder(rest);
+                    break;
+                case "hidden":
+                    if (Cards.isPackageName(rest) && out.hidden.size() < MAX_HIDDEN) out.hidden.add(rest);
+                    break;
+                case "folder": {
+                    int sp2 = rest.indexOf(' ');
+                    if (sp2 <= 0 || out.folders.size() >= MAX_FOLDERS) break;
+                    String id = rest.substring(0, sp2);
+                    String name = rest.substring(sp2 + 1);
+                    if (isId(id) && out.folder(id) == null && isName(name)) {
+                        out.folders.add(new Folder(id, name));
+                    }
+                    break;
+                }
+                case "member": {
+                    int sp2 = rest.indexOf(' ');
+                    if (sp2 <= 0) break;
+                    Folder f = out.folder(rest.substring(0, sp2));
+                    String pkg = rest.substring(sp2 + 1);
+                    if (f != null && Cards.isPackageName(pkg) && f.apps.size() < MAX_MEMBERS
+                            && out.folderOf(pkg) == null && !out.hidden.contains(pkg)) {
+                        f.apps.add(pkg);
+                    }
+                    break;
+                }
+                default:
+                    break;
+            }
+        }
+        if (!header) return null;
+        out.dropEmptyFolders();
+        return out;
+    }
+
+    private int orderSize() {
+        return order == null ? 0 : order.size();
+    }
+
+    private void addOrder(String key) {
+        if (order == null) order = new ArrayList<>();
+        if (!order.contains(key)) order.add(key);
+    }
+
+    /** A tile key: a component ("pkg/.Activity", "pkg/com.x.Y$Z") or a folder ("pkg/folder.id"). */
+    static boolean isKey(String s) {
+        if (s == null || s.isEmpty() || s.length() > 200) return false;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            boolean ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+                    || c == '.' || c == '_' || c == '/' || c == '$' || c == '-';
+            if (!ok) return false;
+        }
+        return true;
+    }
+
+    /** A folder name exactly as {@link #cleanName} writes it. */
+    static boolean isName(String s) {
+        return s != null && !s.isEmpty() && s.length() <= NAME_MAX && cleanName(s).equals(s);
+    }
+
+    static boolean isId(String s) {
+        if (s == null || s.isEmpty() || s.length() > 12) return false;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) return false;
+        }
+        return true;
+    }
+
+    // ---- queries ---------------------------------------------------------------------------------
+
+    /** The saved tile order (component keys), or null for the default order. A copy. */
+    List<String> order() {
+        return order == null ? null : new ArrayList<>(order);
+    }
+
+    Set<String> hidden() {
+        return Collections.unmodifiableSet(hidden);
+    }
+
+    List<Folder> folders() {
+        return Collections.unmodifiableList(folders);
+    }
+
+    Folder folder(String id) {
+        for (Folder f : folders) if (f.id.equals(id)) return f;
+        return null;
+    }
+
+    Folder folderOf(String pkg) {
+        for (Folder f : folders) if (f.apps.contains(pkg)) return f;
+        return null;
+    }
+
+    /** True when nothing was changed: the default order, nothing hidden, no folders. */
+    boolean isDefault() {
+        return order == null && hidden.isEmpty() && folders.isEmpty();
+    }
+
+    // ---- changes (each one is saved at once) -----------------------------------------------------
+
+    void setOrder(List<String> keys) {
+        List<String> next = new ArrayList<>();
+        for (String k : keys) {
+            if (isKey(k) && !next.contains(k) && next.size() < MAX_ORDER) next.add(k);
+        }
+        order = next;
+        persist();
+    }
+
+    void hide(String pkg) {
+        if (!Cards.isPackageName(pkg) || hidden.size() >= MAX_HIDDEN) return;
+        removeFromFolder(pkg);
+        hidden.add(pkg);
+        persist();
+    }
+
+    void unhideAll() {
+        hidden.clear();
+        persist();
+    }
+
+    /** A new folder holding one app, or null at the limit. The app must not be hidden. */
+    Folder newFolder(String name, String firstPkg) {
+        if (folders.size() >= MAX_FOLDERS || !Cards.isPackageName(firstPkg)) return null;
+        String id;
+        int n = 0;
+        do {
+            id = "f" + Long.toString(System.currentTimeMillis() + n++, 36);
+            if (id.length() > 12) id = id.substring(0, 12);
+        } while (folder(id) != null);
+        Folder f = new Folder(id, cleanName(name));
+        removeFromFolder(firstPkg);
+        f.apps.add(firstPkg);
+        folders.add(f);
+        persist();
+        return f;
+    }
+
+    /** Puts the app in the folder (and out of any other). False when the folder is full. */
+    boolean addToFolder(Folder f, String pkg) {
+        if (f == null || !Cards.isPackageName(pkg) || f.apps.size() >= MAX_MEMBERS) return false;
+        removeFromFolder(pkg);
+        f.apps.add(pkg);
+        persist();
+        return true;
+    }
+
+    /** Takes the app out of its folder; a folder left empty goes away. */
+    void takeOut(String pkg) {
+        removeFromFolder(pkg);
+        persist();
+    }
+
+    /** Opens the folder: its apps go back to the grid. */
+    void dissolve(Folder f) {
+        folders.remove(f);
+        persist();
+    }
+
+    void rename(Folder f, String name) {
+        f.name = cleanName(name);
+        persist();
+    }
+
+    /** Back to the default layout; the file is deleted. */
+    void reset() {
+        order = null;
+        hidden.clear();
+        folders.clear();
+        if (file != null && file.exists() && !file.delete()) Log.w(TAG, "cannot delete " + FILE);
+    }
+
+    private void removeFromFolder(String pkg) {
+        Folder f = folderOf(pkg);
+        if (f == null) return;
+        f.apps.remove(pkg);
+        dropEmptyFolders();
+    }
+
+    private void dropEmptyFolders() {
+        for (int i = folders.size() - 1; i >= 0; i--) if (folders.get(i).apps.isEmpty()) folders.remove(i);
+    }
+
+    /** A folder name as the Home screen shows it: the same cleaner as app labels, at most {@link #NAME_MAX} characters. */
+    static String cleanName(String name) {
+        String s = Cards.cleanLabel(name, "Folder");
+        return s.length() > NAME_MAX ? s.substring(0, NAME_MAX).trim() : s;
+    }
+
+    // ---- writing ---------------------------------------------------------------------------------
+
+    String encode() {
+        StringBuilder b = new StringBuilder(HEADER).append('\n');
+        if (order != null) for (String k : order) b.append("order ").append(k).append('\n');
+        for (String p : hidden) b.append("hidden ").append(p).append('\n');
+        for (Folder f : folders) {
+            b.append("folder ").append(f.id).append(' ').append(f.name).append('\n');
+            for (String p : f.apps) b.append("member ").append(f.id).append(' ').append(p).append('\n');
+        }
+        return b.toString();
+    }
+
+    private void persist() {
+        if (file == null) return;
+        if (isDefault()) {
+            if (file.exists() && !file.delete()) Log.w(TAG, "cannot delete " + FILE);
+            return;
+        }
+        AtomicFile af = new AtomicFile(file);
+        FileOutputStream out = null;
+        try {
+            out = af.startWrite();
+            out.write(encode().getBytes(StandardCharsets.UTF_8));
+            af.finishWrite(out);
+        } catch (IOException e) {
+            Log.w(TAG, "cannot write " + FILE + ": " + e);
+            if (out != null) af.failWrite(out);
+        }
+    }
+}

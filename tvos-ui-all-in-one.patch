+                        keyDx = keyDy = 0f;
+                    }
+                    view.animate().scaleX(s).scaleY(s).rotationX(0f).rotationY(0f)
+                            .setDuration(focused ? 340 : 180)
                             .setInterpolator(new OvershootInterpolator(focused ? 1.6f : 0f))
                             .withLayer()
                             .start();

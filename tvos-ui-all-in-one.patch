+package com.gathin.tvhome;
+
+import android.media.AudioAttributes;
+import android.media.AudioFormat;
+import android.media.AudioTrack;
+import android.util.Log;
+
+/**
+ * Soft tvOS style navigation sounds: a short tick when the highlight moves, a two note chime when an app
+ * opens. Nothing is stored or downloaded: two tiny buffers are synthesised once at start (a few KB) and
+ * replayed from memory. Off unless config {@code navigation_sounds} is true. Every failure just means silence.
+ */
+final class NavSounds {
+    private static final String TAG = "TvHome.Sounds";
+    private static final int RATE = 22050;
+
+    private static AudioTrack tick, select, press, bump;
+    private static boolean on;
+
+    private NavSounds() {
+    }
+
+    static void init(boolean enabled) {
+        release();
+        if (!enabled) return;
+        try {
+            tick = build(burst(1900, 26, 0.30f));
+            select = build(chime());
+            press = build(pressTone());
+            bump = build(bumpSweep());
+            on = tick != null && select != null && press != null && bump != null;
+        } catch (Exception | LinkageError e) {
+            Log.w(TAG, "sounds off: " + e);
+            release();
+        }
+    }
+
+    static void release() {
+        on = false;
+        for (AudioTrack t : new AudioTrack[]{tick, select, press, bump}) {
+            if (t != null) {
+                try {
+                    t.release();
+                } catch (Exception ignored) {
+                }
+            }
+        }
+        tick = null;
+        select = null;
+        press = null;
+        bump = null;
+    }
+
+    /** The highlight moved. */
+    static void tick() {
+        play(tick);
+    }
+
+    /** OK went down on a tile: a lower, rounder tap. */
+    static void press() {
+        play(press);
+    }
+
+    /** A key hit the edge of the grid and went nowhere: a short falling blip. */
+    static void bump() {
+        play(bump);
+    }
+
+    /** An app was opened. */
+    static void select() {
+        play(select);
+    }
+
+    private static void play(AudioTrack t) {
+        if (!on || t == null) return;
+        try {
+            if (t.getPlayState() != AudioTrack.PLAYSTATE_STOPPED) t.stop();
+            t.reloadStaticData();
+            t.play();
+        } catch (Exception ignored) {
+        }
+    }
+
+    private static AudioTrack build(short[] pcm) {
+        AudioTrack t = new AudioTrack.Builder()
+                .setAudioAttributes(new AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                        .build())
+                .setAudioFormat(new AudioFormat.Builder()
+                        .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                        .setSampleRate(RATE)
+                        .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                        .build())
+                .setBufferSizeInBytes(pcm.length * 2)
+                .setTransferMode(AudioTrack.MODE_STATIC)
+                .build();
+        if (t.write(pcm, 0, pcm.length) != pcm.length) {
+            t.release();
+            return null;
+        }
+        return t;
+    }
+
+    /** A sine burst with a 2 ms attack and an exponential fade: a soft click, no pop. */
+    private static short[] burst(double hz, int ms, float amp) {
+        short[] out = new short[RATE * ms / 1000];
+        mix(out, 0, hz, amp, 5.0);
+        return out;
+    }
+
+    /** Two overlapping notes, a fifth apart, about 170 ms in all. */
+    private static short[] chime() {
+        short[] out = new short[RATE * 170 / 1000];
+        mix(out, 0, 988, 0.22f, 4.0);
+        mix(out, RATE * 55 / 1000, 1319, 0.24f, 4.0);
+        return out;
+    }
+
+    private static short[] pressTone() {
+        short[] out = new short[RATE * 80 / 1000];
+        mix(out, 0, 784, 0.26f, 5.0);
+        mix(out, 0, 392, 0.12f, 5.0);
+        return out;
+    }
+
+    /** A sine that falls from 700 to 320 Hz over 110 ms. */
+    private static short[] bumpSweep() {
+        short[] out = new short[RATE * 110 / 1000];
+        double phase = 0;
+        for (int i = 0; i < out.length; i++) {
+            double t = (double) i / out.length;
+            double hz = 700 - 380 * t;
+            phase += 2 * Math.PI * hz / RATE;
+            double env = Math.min(1.0, i / (RATE * 0.004)) * Math.exp(-5.0 * t);
+            out[i] = (short) (0.22 * env * Math.sin(phase) * Short.MAX_VALUE);
+        }
+        return out;
+    }
+
+    /** Adds a faded sine starting at sample {@code from} and running to the end of the buffer. */
+    private static void mix(short[] buf, int from, double hz, float amp, double decay) {
+        int n = buf.length - from;
+        int attack = Math.max(1, RATE * 2 / 1000);
+        for (int i = 0; i < n; i++) {
+            double env = Math.min(1.0, (double) i / attack) * Math.exp(-decay * i / n);
+            double v = amp * env * Math.sin(2 * Math.PI * hz * i / RATE);
+            int sum = buf[from + i] + (int) (v * Short.MAX_VALUE);
+            buf[from + i] = (short) Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, sum));
+        }
+    }
+}

new file mode 100644
index 0000000..a4b959a
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/Banners.java
@@ -0,0 +1,77 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.util.Log;
+import android.util.LruCache;
+
+import java.io.File;
+
+/**
+ * High resolution banners that replace an app's own (often 320x180) banner: a file named
+ * {@code <package>.png|jpg|webp} in the launcher's external files directory, {@code banners/}.
+ * Push them with tools/banners.sh. Decoding is downsampled to what the screen needs and cached, so a
+ * 4K image costs about as much memory as a 1080p one; every failure just means "no override".
+ */
+final class Banners {
+    private static final String TAG = "TvHome.Banners";
+    static final String DIR = "banners";
+    private static final String[] EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp"};
+    private static final long MAX_BYTES = 6L * 1024 * 1024;
+
+    private static final LruCache<String, Bitmap> TILES = new LruCache<>(24);
+    private static final LruCache<String, Bitmap> ART = new LruCache<>(3);
+
+    private Banners() {
+    }
+
+    /** The banners folder, or null when external storage is unavailable. */
+    static File dir(Context ctx) {
+        File base = Config.dir(ctx);
+        return base == null ? null : new File(base, DIR);
+    }
+
+    /** The override file for this package, or null. Only a valid package name can name a file. */
+    static File find(File dir, String pkg) {
+        if (dir == null || !Cards.isPackageName(pkg)) return null;
+        for (String ext : EXTENSIONS) {
+            File f = new File(dir, pkg + ext);
+            if (f.isFile() && f.length() > 0 && f.length() <= MAX_BYTES) return f;
+        }
+        return null;
+    }
+
+    /** A tile sized bitmap: at least minWidth wide when the file is that wide, less than twice that. */
+    static Bitmap tile(File f, int minWidth) {
+        return decode(TILES, f, minWidth, Bitmap.Config.ARGB_8888);
+    }
+
+    /** Full screen artwork for the top shelf; half the memory (no alpha), meant for a background thread. */
+    static Bitmap art(File f, int minWidth) {
+        return decode(ART, f, minWidth, Bitmap.Config.RGB_565);
+    }
+
+    private static Bitmap decode(LruCache<String, Bitmap> cache, File f, int minWidth, Bitmap.Config config) {
+        String key = f.getPath() + '|' + f.lastModified() + '|' + f.length() + '|' + minWidth;
+        Bitmap hit = cache.get(key);
+        if (hit != null && !hit.isRecycled()) return hit;
+        try {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(f.getPath(), o);
+            if (o.outWidth <= 0 || o.outHeight <= 0) return null;
+            int sample = 1;
+            while (o.outWidth / (sample * 2) >= minWidth) sample *= 2;
+            o.inJustDecodeBounds = false;
+            o.inSampleSize = sample;
+            o.inPreferredConfig = config;
+            Bitmap b = BitmapFactory.decodeFile(f.getPath(), o);
+            if (b != null) cache.put(key, b);
+            return b;
+        } catch (Exception | OutOfMemoryError e) {
+            Log.w(TAG, f.getName() + ": " + e);
+            return null;
+        }
+    }
+}

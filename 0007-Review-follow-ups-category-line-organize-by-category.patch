+    /**
+     * The apps below the dock that declare the same category, for every category with at least two of them
+     * and not already in a folder. The dock apps stay where they are.
+     */
+    private java.util.Map<Integer, List<String>> organizeGroups() {
+        java.util.Map<Integer, List<String>> groups = new java.util.TreeMap<>();
+        for (int i = COLUMNS; i < adapter.getItemCount(); i++) {
+            AppAdapter.Entry en = adapter.entryAt(i);
+            if (en == null || en.kind != AppAdapter.Entry.APP || AppAdapter.categoryName(en.category) == 0) continue;
+            if (layout.folderOf(en.pkg) != null) continue;
+            List<String> list = groups.get(en.category);
+            if (list == null) groups.put(en.category, list = new ArrayList<>());
+            if (!list.contains(en.pkg)) list.add(en.pkg);
+        }
+        java.util.Iterator<java.util.Map.Entry<Integer, List<String>>> it = groups.entrySet().iterator();
+        while (it.hasNext()) if (it.next().getValue().size() < 2) it.remove();
+        return groups;
+    }
+
+    /** One folder per category (Games, Video, Music...), named in the TV's language. */
+    private void organizeByCategory() {
+        for (java.util.Map.Entry<Integer, List<String>> g : organizeGroups().entrySet()) {
+            List<String> pkgs = g.getValue();
+            HomeLayout.Folder f = layout.newFolder(getString(AppAdapter.categoryName(g.getKey())), pkgs.get(0));
+            if (f == null) break;   // the folder limit
+            for (int i = 1; i < pkgs.size(); i++) layout.addToFolder(f, pkgs.get(i));
+        }
+        reloadTiles();
+        restoreFocus();
+    }
+
     /** After a folder was made, renamed or added to: rebuild the tiles and focus the folder's tile. */
